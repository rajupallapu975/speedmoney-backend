# Database Connection String (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/loan_platform?sslmode=prefer"

# JWT Secret Key
JWT_SECRET="your-jwt-secret-key-change-in-production"

# Port (optional, defaults to 8860)
PORT=8860

# Razorpay Test Mode Credentials (NEVER commit real credentials)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Node Environment
NODE_ENV="production"

